# Copy to .env and fill in.  .env is gitignored, so the key never enters the repository.
# The CLI reads only the variables below.  The Anthropic SDK reads ANTHROPIC_API_KEY itself.
ANTHROPIC_API_KEY=

# Optional overrides.  The defaults are shown.
INTAKE_AGENT_MODEL=claude-opus-5-5
INTAKE_AGENT_EFFORT=medium
INTAKE_AGENT_MAX_TURNS=8
